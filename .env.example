# Core deployment settings. install.sh generates the real .env.
N8N_HOST=automation.example.com
TIMEZONE=Asia/Tehran
N8N_IMAGE=n8nio/n8n:latest
KUMA_IMAGE=louislam/uptime-kuma:2
NGINX_IMAGE=nginx:1.28.0-alpine
KUMA_PORT=3001

# TLS mode. Existing certificates live below LETSENCRYPT_PATH/live/TLS_CERT_NAME.
TLS_ENABLED=true
LETSENCRYPT_PATH=/etc/letsencrypt
TLS_CERT_NAME=automation.example.com
TLS_VOLUME_SOURCE=/etc/letsencrypt
PUBLIC_SCHEME=https

# These prefixes select the TLS or plain-HTTP blocks in the Nginx template.
# install.sh maintains them; do not set both to the same value.
NGINX_TLS_PREFIX=""
NGINX_HTTP_PREFIX="#"

BACKUP_RETENTION_DAYS=14
