# Non-secret Ceph RGW / S3-compatible settings.
CEPH_S3_ENDPOINT=https://s3.example.com
CEPH_S3_BUCKET=n8n-backups
CEPH_S3_PREFIX=production
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=ceph
AWS_SHARED_CREDENTIALS_FILE=.secrets/aws/credentials
AWS_CLI_IMAGE=public.ecr.aws/aws-cli/aws-cli:2.27.41

# installer/ceph.sh writes access keys to the ignored credentials file above.
# Do not add access keys or secret keys to this file.
