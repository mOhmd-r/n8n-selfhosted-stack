# Generated interactively by installer/rsync.sh as .env.rsync.
RSYNC_HOST=backup.example.com
RSYNC_PORT=22
RSYNC_USER=backup
RSYNC_PATH=/srv/backups/n8n

# Reference an existing key; never copy it into this repository.
RSYNC_SSH_KEY=/home/operator/.ssh/n8n-backup
RSYNC_KNOWN_HOSTS_FILE=/home/operator/.ssh/known_hosts
